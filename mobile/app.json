{
  "expo": {
    "name": "PlantCare",
    "slug": "plantcare",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "plantcare",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1929"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plantcare.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "NSCameraUsageDescription": "PlantCare usa la cámara para que fotografíes tu planta y así identificar su especie y crear su personaje.",
        "NSPhotoLibraryUsageDescription": "PlantCare accede a tus fotos para que elijas una imagen de tu planta e identificar su especie.",
        "NSMicrophoneUsageDescription": "PlantCare usa el micrófono solo durante la llamada de voz, para que puedas conversar con tu planta."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1929"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.plantcare.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PlantCare usa la cámara para que fotografíes tu planta y así identificar su especie y crear su personaje.",
          "recordAudioAndroid": false,
          "microphonePermission": "PlantCare usa el micrófono solo durante la llamada de voz, para que puedas conversar con tu planta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantCare accede a tus fotos para que elijas una imagen de tu planta e identificar su especie.",
          "cameraPermission": "PlantCare usa la cámara para que fotografíes tu planta y así identificar su especie y crear su personaje.",
          "microphonePermission": "PlantCare usa el micrófono solo durante la llamada de voz, para que puedas conversar con tu planta."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "PlantCare usa el micrófono solo durante la llamada de voz, para que puedas conversar con tu planta."
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5eb08ad4-69e9-42cb-9924-90742317bb25"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5eb08ad4-69e9-42cb-9924-90742317bb25"
    }
  }
}
